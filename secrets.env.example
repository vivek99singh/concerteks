# Copy to secrets.env, fill in, then: chmod 600 secrets.env
# run-all.sh reads it; anything left empty is prompted for at start.
export IBM_ENTITLEMENT_KEY=        # https://myibm.ibm.com/products-services/containerlibrary
export WATSONX_API_KEY=            # IBM Cloud API key for watsonx.ai
export WATSONX_API_PROJECT_ID=
export CONCERT_ADMIN_PASSWORD=
# Only available after install (Concert UI -> profile -> API key). If empty, run-all.sh pauses and asks.
export CONCERT_API_KEY=

# Optional overrides
# export CLUSTER=concert-demo REGION=us-east-1 CAPACITY_TYPE=ON_DEMAND
# export WATSONX_API_URL=https://eu-gb.ml.cloud.ibm.com
